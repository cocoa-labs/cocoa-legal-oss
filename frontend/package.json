{
    "name": "cocoa-legal-frontend",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "next dev -p 3003",
        "build": "next build",
        "test:document-reliability": "node --import tsx src/app/components/doc-review/documentReliability.test.ts && node --import tsx src/app/components/doc-review/deriveConversationDoc.test.ts && node --import tsx src/app/components/authoring/documentPacketState.test.ts && node --import tsx src/app/lib/appVersionState.test.ts && node --import tsx src/app/lib/protectedDownload.test.ts && node --import tsx --test src/app/lib/documentJobPolling.test.ts src/app/components/assistant/AssistantMessage.documentPackets.test.ts",
        "test:assistant-stream": "node --import tsx src/app/lib/assistantStreamAccumulator.test.ts",
        "test:public-settings": "node --import tsx src/app/lib/deploymentLinks.test.ts && node --import tsx src/app/lib/signatureConsentCopy.test.ts && node --import tsx src/app/lib/betaPolicyGate.test.ts",
        "start": "next start",
        "lint": "eslint",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
    },

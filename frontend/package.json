        "katex": "^0.16.27",
        "lucide-react": "^0.553.0",
        "marked": "^17.0.1",
        "next": "16.4.6",
        "pdfjs-dist": "4.10.38",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-markdown": "^10.1.0",

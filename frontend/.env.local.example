NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY= is accepted as a fallback alias for the key above.
# Backend origin. Default backend port is 3001; use http://localhost:3004 when running via restart-dev.sh.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# This deployment's public origin (used for link previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3003
# Optional legal pages: the sign-up and policy links are hidden when blank.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
# Source link in the account menu. Blank = the public Cocoa Legal repository; if
# you run a modified version, point it at your fork (AGPL-3.0 section 13).
NEXT_PUBLIC_SOURCE_CODE_URL=

# Privacy-scrubbed beta telemetry. Server-side source-map upload variables
# (SENTRY_AUTH_TOKEN/SENTRY_ORG/SENTRY_PROJECT) belong in CI, never NEXT_PUBLIC.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEPLOYMENT_ID=local-beta
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Set false to hide model-health badges and selection warnings independently
# of backend health collection and runtime failover.
NEXT_PUBLIC_MODEL_HEALTH_INDICATORS_ENABLED=true

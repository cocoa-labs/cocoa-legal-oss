# Backend HTTP port. Defaults to 3001 when unset. restart-dev.sh expects the
# backend on :3004 — set PORT=3004 in your local backend/.env when using it.
PORT=3001
# Frontend origin, allowed for CORS. The frontend dev server always runs on
# :3003 (frontend/package.json pins "next dev -p 3003").
FRONTEND_URL=http://localhost:3003
# Extra comma-separated CORS origins beyond FRONTEND_URL (dev localhost ports
# are always allowed outside production).
CORS_ORIGINS=http://localhost:3003
# Direct Postgres connection used only by the transactional migration/backup
# commands. Keep it out of frontend and application logs.
DATABASE_URL=postgresql://postgres:password@db.example.invalid:5432/postgres
# Uncomment in production: restricts CORS to configured origins and enables
# prod-only guards.
# NODE_ENV=production
# Firm slug shared by every user of this deployment (shared playbook and firm
# memory). Must equal organizations.slug; migration 027 and `npm run seed:firm`
# both default to pilot-firm.
FIRM_ID=pilot-firm

# HMAC key used to sign /download/:token URLs. Required at startup (left blank
# on purpose so a copied example can't run with a published value).
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from SUPABASE_SECRET_KEY.
DOWNLOAD_SIGNING_SECRET=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=cocoa-legal
# Set false for providers that require virtual-hosted-style URLs, such as current Railway Buckets.
S3_FORCE_PATH_STYLE=true
# Browser-facing endpoint for presigned download links, when browsers reach
# storage on a different host than the backend does (Docker Compose sets
# http://localhost:9000 for the bundled RustFS). Blank = R2_ENDPOINT_URL.
R2_PUBLIC_ENDPOINT_URL=

# --- Controlled beta safety and operational controls ---
# Beta must remain fail-closed: synthetic/redacted files only, approved test
# recipients only, and nonbinding signatures.
BETA_MODE=true
# Use shadow only during the documented mismatch audit; strict is the beta gate.
TENANCY_AUTH_MODE=strict
UPLOAD_SCANNING_REQUIRED=true
# Private clamd endpoint. Never expose port 3310 publicly.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
MATTER_TASK_WORKER_ENABLED=true
LIFECYCLE_PURGE_ENABLED=true
# Immutable build/release identifier surfaced by health and telemetry.
DEPLOYMENT_ID=local-beta
APP_ENV=development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Separately credentialed encrypted backup/mirror destination.
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
BACKUP_AGE_RECIPIENT=
# Restore drills additionally require BACKUP_AGE_IDENTITY_FILE,
# RESTORE_BACKUP_FILE, RESTORE_DATABASE_URL, and
# RESTORE_DRILL_CONFIRM=disposable.

# Model provider keys. Leave blank to let each user add their own key under
# Account > Models & API Keys. Setting one here makes that provider
# instance-wide and locks the per-user field for it.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY= is accepted as a legacy alias; ANTHROPIC_API_KEY wins if both are set.
OPENAI_API_KEY=
# OpenRouter routes the whole model catalog through one key. Optional — the
# native Anthropic/Gemini/OpenAI paths and the picker's featured section work
# without it; only the OpenRouter catalog section needs it to send requests.
OPENROUTER_API_KEY=
# Attribution shown on OpenRouter's dashboards (both optional).
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=
# Legal search providers (server-managed; legal_search runs with any subset).
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
# TAVILY_KEY= / EXA_KEY= / FIRECRAWL_KEY= are accepted as legacy aliases of the *_API_KEY forms above.
# Per-provider timeout for the legal_search tool, in ms (blank = 15000; clamped 1000-60000).
LEGAL_SEARCH_PROVIDER_TIMEOUT_MS=
# Encrypts per-user API keys at rest. Required before users can save keys.
# Generate with: openssl rand -hex 32
USER_API_KEYS_ENCRYPTION_SECRET=

# --- HTTP tuning knobs (optional; blank uses the built-in default) ---
# Reverse-proxy hops to trust when resolving client IPs for rate limiting (default 1).
TRUST_PROXY_HOPS=
# Per-IP rate-limit windows and caps (defaults: general 1000/15min, chat 30/15min,
# chat-create 60/15min, upload 50/1h, sign 60/15min).
RATE_LIMIT_GENERAL_WINDOW_MINUTES=
RATE_LIMIT_GENERAL_MAX=
RATE_LIMIT_CHAT_WINDOW_MINUTES=
RATE_LIMIT_CHAT_MAX=
RATE_LIMIT_CHAT_CREATE_WINDOW_MINUTES=
RATE_LIMIT_CHAT_CREATE_MAX=
RATE_LIMIT_UPLOAD_WINDOW_HOURS=
RATE_LIMIT_UPLOAD_MAX=
RATE_LIMIT_SIGN_WINDOW_MINUTES=
RATE_LIMIT_SIGN_MAX=

# --- Email: dedicated agent inbox via Gmail API (Google Workspace) ---
# Service account with domain-wide delegation that impersonates the agent mailbox.
# Agent mailbox address, e.g. agent@your-domain.example. Blank = email features off.
GMAIL_AGENT_ADDRESS=
# Display name shown on outbound emails' From header (defaults to "Quill (AI legal assistant)"). Set empty to use the bare address.
GMAIL_AGENT_NAME=Quill (AI legal assistant)
# Service account, e.g. agent-mailer@your-project.iam.gserviceaccount.com, and its
# private key as one line with \n escapes ("-----BEGIN PRIVATE KEY-----\n...").
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Shared secret gating the public inbound endpoints (/email-inbound/webhook, /poll).
GMAIL_INBOUND_WEBHOOK_SECRET=
# User id that owns inbound agent-mailbox rows not linked to an agent-started
# chat (blank falls back to GMAIL_AGENT_ADDRESS as the owner string).
GMAIL_AGENT_OWNER_USER_ID=
# Autonomy kill switches — both default OFF; only the literal string "true" enables.
# Autonomous auto-SEND of replies on agent-initiated threads (no human approval).
EMAIL_AUTOREPLY_ENABLED=false
# "Auto-draft, you approve": inbound replies get a parked draft awaiting a human
# click. Preferred over auto-send when both are enabled.
EMAIL_AUTODRAFT_ENABLED=false
# Cap on outbound auto-replies per thread (blank = 10).
EMAIL_AUTOREPLY_MAX_PER_THREAD=

# --- Calendar: Quill's own Google Calendar(s) (Google Workspace) ---
# Reuses the SAME service account + domain-wide delegation as email above
# (GMAIL_AGENT_ADDRESS / GOOGLE_SA_CLIENT_EMAIL / GOOGLE_SA_PRIVATE_KEY). No new
# credentials — but the scope https://www.googleapis.com/auth/calendar MUST be
# added to the service account's client-ID allowlist in Google Workspace Admin →
# Security → API Controls → Domain-wide Delegation, or every call 403s.
# Display name of the shared firm calendar (find-or-created under the agent
# mailbox on first use; its generated id is cached in calendar_sync_state).
CALENDAR_FIRM_NAME=Cocoa Legal
# Default IANA timezone applied to timed events + the firm calendar.
CALENDAR_DEFAULT_TIMEZONE=America/Los_Angeles
# Deadline-reminder background worker — OFF unless the literal string "true".
# When on, it sweeps due legal deadlines and drafts an approval-gated reminder
# email to the deadline's owner (never auto-sent). No-op until migration 026 is
# applied. Poll interval defaults to 15 minutes.
CALENDAR_REMINDER_WORKER_ENABLED=false
CALENDAR_REMINDER_POLL_INTERVAL_MS=

# --- E-signature (native, self-owned) ---
# Optional absolute path to `soffice`. Leave blank to discover LibreOffice from
# PATH (including Nixpacks/Homebrew) and then common OS install locations.
SOFFICE_BINARY_PATH=
# Hard timeout for one LibreOffice conversion (blank = 60000ms; clamped to
# 1000..300000ms).
LIBREOFFICE_CONVERSION_TIMEOUT_MS=
# How many soffice processes may convert at once (blank = 1). Defaults to 1
# because each soffice peaks around 150-300 MB, and uploads, clean copies,
# transcript PDFs, previews and signature approvals all overlap in practice —
# serializing them bounds total converter memory under the platform's cap.
# Raising it trades memory for conversion throughput; take it up one step at a
# time and watch RSS. Read lazily at the first conversion, so it is tunable
# from the dashboard without a redeploy.
LIBREOFFICE_MAX_CONCURRENT=
# Boot-time warm-up conversion (blank = on; only a literal "false" disables).
# On startup the server converts one tiny document so the log says whether
# conversion actually WORKS in this image, and so the first real request finds
# a warm soffice. Set false if the extra ~150-300 MB at boot is implicated in
# memory pressure or a restart loop — it stops the spawn without a redeploy.
# The binary-discovery check still runs and still logs.
LIBREOFFICE_WARMUP_ENABLED=
# Public origin that hosts the signer page (/sign/<token>). Must match where the
# frontend actually serves — local dev runs on :3003 (see frontend "dev" script).
# In production set this to the real public origin, e.g. https://app.your-domain.example.
SIGN_PUBLIC_BASE_URL=http://localhost:3003
# E-signature signing identity: base64 PKCS#12 + passphrase. Generate the firm's
# persistent org certificate with `npx tsx scripts/generateSigningCert.ts` (RSA-4096,
# aes256 P12; validated at boot — a set-but-broken value refuses to start). If unset,
# an EPHEMERAL dev self-signed cert is minted per process (identity changes every
# restart; production logs a startup warning). A purchased AATL/CA cert (RSA only,
# exported with its full chain) swaps in via these same two values.
SIGNING_CERT_P12_BASE64=
SIGNING_CERT_PASSPHRASE=
# Contact and location written into each signed PDF's signature dictionary
# (shown by PDF readers). Blank = left empty.
SIGNING_CONTACT_EMAIL=
SIGNING_LOCATION=

# --- Recordings & transcription (audio → AssemblyAI → Quill summary) ---
# AssemblyAI API key — server-only, no per-user BYOK. Enables the batch
# transcription worker; the worker stays OFF until this is set.
ASSEMBLYAI_API_KEY=
# Set false to keep the worker off even when the key is present (default: on when keyed).
RECORDINGS_WORKER_ENABLED=
# Worker poll cadence in ms (blank = 15000; clamped to a 2000ms floor).
RECORDINGS_POLL_INTERVAL_MS=
# Max retries per pipeline step (blank = 3; 0 = never retry).
RECORDINGS_MAX_RETRIES=
# Model for summary / action items / briefing scripts (blank = product default, claude-sonnet-5).
RECORDINGS_MODEL=
# OpenAI voice-briefing model + voice (blank = gpt-4o-mini-tts / alloy).
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
# OpenAI timeline-image model (blank = gpt-image-2; user-pinned for text rendering).
OPENAI_IMAGE_MODEL=
# Image quality for generated images (blank = high).
OPENAI_IMAGE_QUALITY=

# --- Personal-injury email automation (see docs/pi-automation.md) ---
# Master switch: the scheduler is a no-op unless the literal string "true".
AUTOMATION_ENABLED=false
# Drafts only (blank = on): acknowledgements are drafted for human approval and
# are never sent automatically unless this is exactly "false".
AUTOMATION_DRAFTS_ONLY=
# Set false to classify with deterministic rules only (blank = LLM classification on).
AUTOMATION_LLM_CLASSIFY_ENABLED=
# Model for the pipeline's LLM steps (blank = product default).
AUTOMATION_MODEL=
# Poll cadence in ms (blank = 120000), retries per step (blank = 3), and polls
# between full reconciliations (blank = 30).
AUTOMATION_POLL_INTERVAL_MS=
AUTOMATION_MAX_RETRIES=
AUTOMATION_RECONCILE_EVERY_N_TICKS=

# --- Document generation and conversation memory ---
# Set false to disable long-document generation jobs (blank = on).
DOCUMENT_GENERATION_ENABLED=
# Upper bound on drafting chunks per section (blank = 64).
DOCUMENT_GENERATION_MAX_SECTION_CHUNKS=
# Set false to stop background summaries of long conversations (blank = on).
CONVERSATION_SUMMARY_ENABLED=

# --- Chat capability-suggestion chips (hybrid intent detection) ---
# All optional; every reader has a safe default and none is ever fatal.
# Set false to switch the LLM classifier off entirely — detection then falls
# back to the deterministic structural rule (attached filename / document type).
INTENT_LLM_CLASSIFY_ENABLED=
# Model the classifier runs on (blank = product default, claude-sonnet-5).
INTENT_CLASSIFIER_MODEL=
# Wall-clock budget for one classification, in ms (blank = 6000). On a timeout
# the turn falls back to the structural rule.
INTENT_CLASSIFIER_TIMEOUT_MS=
# How long the route waits for a still-running classification AFTER the answer
# has finished streaming, in ms (blank = 1500; 0 = never wait).
INTENT_POST_STREAM_GRACE_MS=
# Minimum self-reported confidence a classification needs to become a chip
# (blank = 0.8; clamped to 0..1).
INTENT_LLM_MIN_CONFIDENCE=
# Set false to let the classifier propose a capability the lexical prefilter
# did not match (blank = on, i.e. agreement required).
INTENT_LLM_REQUIRE_LEXICAL_AGREEMENT=

# --- Provider-neutral model reliability ---
# Set false to disable automatic cross-model rescue while retaining the
# selected-model retry and completion validation.
MODEL_RUNTIME_FAILOVER_ENABLED=true
# Set false to pause synthetic non-user conformance checks and health scoring.
MODEL_HEALTH_WORKER_ENABLED=true

# Retry saved email attachments independently of PI automation.
EMAIL_ATTACHMENT_WORKER_ENABLED=true

# Docker Compose settings for Coco Legal. Copy to `.env` next to docker-compose.yml:
#   cp compose.env.example .env
# With the local Supabase stack, take the URL and anon key from
# `npx supabase@3.1.0 status`.

# --- Frontend build arguments (compiled into the browser bundle) -------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-the-anon-key-from-supabase-status
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3003
# Optional. Your own legal pages (links are hidden when empty) and, if you run a
# modified fork, its public source URL (AGPL-3.0 section 13).
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_SOURCE_CODE_URL=

# --- Backend overrides inside the Compose network ----------------------------
# Where the backend container reaches Supabase (the CLI stack runs on the host).
BACKEND_SUPABASE_URL=http://host.docker.internal:54321
# Host the browser uses for presigned download links.
R2_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- Local storage credentials (RustFS root keys, also used by the backend) ----
# Required. Generate the secret with `openssl rand -hex 24`; Compose refuses to
# start while it is blank.
S3_ACCESS_KEY=cocolegal
S3_SECRET_KEY=
